# ABOUTME: Template for required environment variables
# ABOUTME: Copy to .env and fill in your actual API keys

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenRouter (multi-model routing)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Perplexity search
PERPLEXITY_API_KEY=pplx-your_perplexity_key_here

# Brave search
BRAVE_API_KEY=your_brave_api_key_here

# MiniMax model provider
MINIMAX_AUTH_TOKEN=your_minimax_jwt_token_here

# GLM (Zhipu AI) model provider
GLM_AUTH_TOKEN=your_glm_auth_token_here

# Kimi model provider
KIMI_AUTH_TOKEN=sk-kimi-your_kimi_key_here

# GitHub (for MCP server and gh CLI)
GITHUB_TOKEN=ghp_your_github_token_here
