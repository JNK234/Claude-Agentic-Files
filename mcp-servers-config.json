{
  "description": "MCP Server Configuration for Claude Agentic System",
  "version": "2.0.0",
  "servers": [
    {
      "name": "sequential-thinking",
      "description": "Advanced sequential thinking and problem analysis",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "transport": "stdio",
      "category": "reasoning"
    },
    {
      "name": "filesystem",
      "description": "File system operations and management",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "$HOME/Developer"],
      "transport": "stdio",
      "category": "system",
      "config": {
        "allowed_directories": ["$HOME/Developer"]
      }
    },
    {
      "name": "context7",
      "description": "Documentation and context retrieval",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "transport": "stdio",
      "category": "documentation"
    },
    {
      "name": "zen",
      "description": "Advanced AI workflow tools and collaboration",
      "command": "$HOME/Developer/MCPs/zen-mcp-server/zen-mcp-server",
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
      },
      "transport": "stdio",
      "category": "ai-workflows"
    },
    {
      "name": "gcloud-mcp",
      "description": "Google Cloud CLI integration",
      "command": "npx",
      "args": ["-y", "@google-cloud/gcloud-mcp"],
      "transport": "stdio",
      "category": "cloud"
    },
    {
      "name": "cloud-run-mcp",
      "description": "Google Cloud Run deployment",
      "command": "npx",
      "args": ["-y", "@google-cloud/cloud-run-mcp"],
      "transport": "stdio",
      "category": "cloud"
    }
  ],
  "presets": {
    "minimal": ["filesystem", "context7"],
    "development": ["filesystem", "context7", "sequential-thinking"],
    "full": ["sequential-thinking", "filesystem", "context7", "zen", "gcloud-mcp", "cloud-run-mcp"],
    "hpc": ["filesystem", "context7", "sequential-thinking"]
  }
}
